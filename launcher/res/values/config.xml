<?xml version="1.0" encoding="utf-8"?>
<!--
  Personaliza SlimTV aquí y recompila con:  pwsh scripts/build.ps1 -Install
  Para saber el paquete de una app:          pwsh scripts/diagnose.ps1
-->
<resources>
    <!-- Favoritas: llenan la barra, en este orden, mientras no haya historial de uso.
         Después la barra se ordena sola por uso reciente (y por las que fijes con OK sostenido).
         Las que no estén instaladas se ignoran. -->
    <string-array name="favorite_apps">
        <item>com.netflix.ninja</item>
        <item>com.crunchyroll.crunchyroid</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.wbd.stream</item>
        <!-- Otros comunes:
             com.disney.disneyplus          Disney+
             com.spotify.tv.android         Spotify
             com.apple.atve.androidtv.appletv  Apple TV
             com.plexapp.android            Plex
             org.videolan.vlc               VLC -->
    </string-array>

    <!-- Apps que no aparecen en ningún lado ("Ajustes" ya tiene su botón arriba). -->
    <string-array name="hidden_apps">
        <item>com.android.tv.settings</item>
    </string-array>

    <!-- Apps de música que controla el mini reproductor. Necesitan poder sonar en segundo plano:
         restrict-background.ps1 no las restringe. (YouTube Music en TV abre YouTube, que se
         pausa al salir, así que no sirve aquí.) -->
    <string-array name="music_apps">
        <item>com.spotify.tv.android</item>
    </string-array>

    <!-- Máximo de apps en la barra (se desplaza); el resto está en "Todas las apps". -->
    <integer name="row_max">10</integer>
    <integer name="grid_columns">6</integer>

    <!-- Minutos entre cambios de fondo en el inicio y en el protector de pantalla. -->
    <integer name="wallpaper_minutes">10</integer>
    <integer name="screensaver_minutes">5</integer>
</resources>
